{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "onyxsi": {
        "type": "local",
        "command": ["python", "onyxsi-mcp.py", "--workspace", "."],
        "codemode": true,
        "timeout": {
          "startup": 60000,
          "catalog": 30000,
          "execution": 600000
        }
      }
    }
  }
}
